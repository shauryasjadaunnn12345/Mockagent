# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side (server actions / route handlers). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment (used to build mock gateway URLs shown in the dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production for shared API gateway rate limits (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
