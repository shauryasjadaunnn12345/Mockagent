# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side (server actions / route handlers). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment (used to build mock gateway URLs shown in the dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production for shared API gateway rate limits (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel scheduled log cleanup authorization secret.
CRON_SECRET=

# Optional semantic QA judge (OpenAI-compatible chat completions endpoint).
SEMANTIC_JUDGE_BASE_URL=https://api.mistral.ai/v1
SEMANTIC_JUDGE_API_KEY=
SEMANTIC_JUDGE_MODEL=mistral-small-latest

# Dodo Payments subscriptions. Use test_mode locally and live_mode in production.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_SOLO_PRODUCT_ID=
DODO_PAYMENTS_TEAM_PRODUCT_ID=
