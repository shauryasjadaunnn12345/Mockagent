# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Only used server-side (server actions / route handlers). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of this deployment (used to build mock gateway URLs shown in the dashboard)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production for shared API gateway rate limits (Upstash Redis).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel scheduled log cleanup authorization secret.
CRON_SECRET=

# First-party Meta Model API (preferred; enables Muse Spark / Muse Wonder and
# the Responses API reasoning/tool-calling loop in Agent Playground).
MODEL_API_KEY=
META_MODEL=muse-spark-1.3
META_MODEL_API_BASE_URL=https://api.meta.ai/v1

# Optional Baseten-hosted Muse Spark Open compatibility provider.
# Used when MODEL_API_KEY is not set. Also powers Tool Studio, assistant,
# regression generation, and Semantic QA when configured.
SEMANTIC_JUDGE_BASE_URL=https://inference.baseten.co/v1
SEMANTIC_JUDGE_API_KEY=
SEMANTIC_JUDGE_MODEL=meta-models/muse-spark-open-1026

# Optional Gemini fallback for the Meta coverage demo on Meta API rate limits.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Dodo Payments subscriptions. Use test_mode locally and live_mode in production.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_SOLO_PRODUCT_ID=
DODO_PAYMENTS_TEAM_PRODUCT_ID=

# Optional OpenTelemetry Protocol (OTLP/HTTP) export. Disabled when no endpoint
# is set. Do not add prompts, tool arguments, or mock response data here.
OTEL_SERVICE_NAME=mockagent
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer%20your-collector-token
